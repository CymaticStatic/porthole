    <!-- Keep Porthole running (BatteryGuideActivity) -->
    <string name="settings_battery_title">Keep Porthole running</string>
    <string name="settings_battery_intro">To tell you when a session needs you, Porthole stays connected to your computers in the background. Android sometimes stops apps it thinks are idle, and then your alerts arrive late or not at all.</string>
    <string name="settings_battery_how">Tap the button below and choose Allow. Porthole uses very little battery while it waits.</string>
